# Server Port (Render sets this automatically to 10000 or defaults to 3001)
PORT=3001

# PostgreSQL Database Connection String (used by Prisma ORM)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/boot_dashboard?schema=public"

# Redis Configuration (Required for BullMQ async jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
